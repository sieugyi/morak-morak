-- Run this in Supabase SQL Editor. Each user can read/write only their own garden save.
create table if not exists public.garden_saves (
 user_id uuid primary key references auth.users(id) on delete cascade,
 state jsonb not null default '{}'::jsonb,
 updated_at timestamptz not null default now()
);
alter table public.garden_saves enable row level security;
create policy "garden owner read" on public.garden_saves for select to authenticated using ((select auth.uid()) = user_id);
create policy "garden owner insert" on public.garden_saves for insert to authenticated with check ((select auth.uid()) = user_id);
create policy "garden owner update" on public.garden_saves for update to authenticated using ((select auth.uid()) = user_id) with check ((select auth.uid()) = user_id);
create policy "garden owner delete" on public.garden_saves for delete to authenticated using ((select auth.uid()) = user_id);
